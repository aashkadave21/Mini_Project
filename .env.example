# =============================================================================
# SDREP — Environment Configuration
# =============================================================================

# Backend Port
PORT=3001

# Application Environment (development | production | test)
NODE_ENV=development

# Relational Database Connection (PostgreSQL)
# Optional: If not provided or unreachable, SDREP automatically activates its
# built-in ACID relational storage engine with full rollback and persistence.
DATABASE_URL=postgresql://sdrep_user:sdrep_secure_pass@localhost:5432/sdrep_db

# Cryptographic Token Signing Key
JWT_SECRET=sdrep_super_secret_jwt_key_2026

# Frontend API Base Target
VITE_API_URL=http://localhost:3001/api/v1
