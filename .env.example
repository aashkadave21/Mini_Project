# =============================================================================
# SDREP — Environment Configuration
# =============================================================================

# Backend Port
PORT=3001

# Application Environment (development | production | test)
NODE_ENV=development

# Relational Database Connection (PostgreSQL / Supabase)
# Option A (Direct connection):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Option B (Supabase Session Pooler - recommended for networks without IPv6):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Note: If DATABASE_URL is omitted, SDREP automatically activates its built-in
# persistent ACID RelationalStorageEngine with full rollback and disk persistence.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Cryptographic Token Signing Key
JWT_SECRET=sdrep_super_secret_jwt_key_2026

# Frontend API Base Target
VITE_API_URL=http://localhost:3001/api/v1
